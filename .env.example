# GitHub API Token (optional but increases rate limit from 60 to 5000 requests/hour)
GITHUB_TOKEN=your_github_pat_optional_but_increases_rate_limit

# PostgreSQL Database Connection
DATABASE_URL=postgresql://prism:prism@postgres:5432/prism

# Ollama Configuration (for local development with Docker)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Frontend API URL (public environment variable)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend AI Service URL (internal service communication)
AI_SERVICE_URL=http://ai:8000